{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TERMISMUS",
  "version": "0.1.0",
  "identifier": "com.mktr.vault",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TERMISMUS",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
